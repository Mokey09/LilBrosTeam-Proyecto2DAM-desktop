<Window x:Class="CalendarioApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:CalendarioApp.Converters"
        xmlns:views="clr-namespace:CalendarioApp.Views"
        Title="Calendario" Height="640" Width="1040" MinHeight="520" MinWidth="860"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6">

    <Window.Resources>
        <conv:DiaBloqueadoOpacidadConverter x:Key="BloqueadoConverter"/>
        <conv:MinusculasConverter x:Key="MinusculasConverter"/>
        <conv:DiaLectivoHabilitadoConverter x:Key="HabilitadoConverter"/>

        <!-- Botones de la barra lateral -->
        <Style x:Key="BotonLateral" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="borde" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botones de acción -->
        <Style x:Key="BotonAccion" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="borde" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Días del calendario: los bloqueados se ven apagados -->
        <Style x:Key="DiaCalendarioStyle" TargetType="CalendarDayButton"
               BasedOn="{StaticResource {x:Type CalendarDayButton}}">
            <!-- Sábados y domingos: no seleccionables -->
            <Setter Property="IsEnabled" Value="{Binding Path=., Converter={StaticResource HabilitadoConverter}}"/>
            <Setter Property="Opacity">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource BloqueadoConverter}">
                        <Binding Path="."/>
                        <Binding Path="DataContext.Version" RelativeSource="{RelativeSource AncestorType=Window}"/>
                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    </MultiBinding>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Etiqueta" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="340"/>
        </Grid.ColumnDefinitions>

        <!-- ================= BARRA LATERAL ================= -->
        <Border Grid.Column="0" Background="#1F2937">
            <StackPanel Margin="0,20,0,0" HorizontalAlignment="Center">
                <!-- Botón para ir a la página de iniciar sesión -->
                <Button x:Name="BtnIniciarSesion" Style="{StaticResource BotonLateral}"
                        Content="&#xE77B;" ToolTip="Iniciar sesión" Click="BtnIniciarSesion_Click"/>
                <!-- Botón para ir al calendario (solo con sesión iniciada) -->
                <Button x:Name="BtnCalendario" Style="{StaticResource BotonLateral}"
                        Content="&#xE80F;" ToolTip="Calendario" Click="BtnCalendario_Click"/>
                <!-- Botón para ir a la página de profesores (solo DIRECTOR) -->
                <Button x:Name="BtnProfesores" Style="{StaticResource BotonLateral}"
                        Content="&#xE716;" ToolTip="Profesores" Click="BtnProfesores_Click"/>
                <!-- Botón para ir a modificar calendario -->
                <Button x:Name="BtnModificarCalendario" Style="{StaticResource BotonLateral}"
                        Content="&#xE787;" ToolTip="Modificar calendario" Click="BtnCalendario_Click"/>
            </StackPanel>
        </Border>

        <!-- ================= ZONA CENTRAL ================= -->
        <Grid x:Name="ZonaCalendario" Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="12"
                    BorderBrush="#E5E7EB" BorderThickness="1">
                <!-- El Viewbox hace que el calendario ocupe toda la zona -->
                <Viewbox Stretch="Uniform">
                    <Calendar x:Name="Calendario"
                              SelectionMode="SingleDate"
                              SelectedDate="{Binding FechaSeleccionada, Mode=TwoWay}"
                              DisplayDate="{Binding FechaSeleccionada, Mode=OneWay}"
                              CalendarDayButtonStyle="{StaticResource DiaCalendarioStyle}"
                              Background="White" BorderThickness="0"/>
                </Viewbox>
            </Border>

            <WrapPanel Grid.Row="1" Margin="0,16,0,0">
                <Button x:Name="BtnImportar" Content="Importar calendario"
                        Style="{StaticResource BotonAccion}" Margin="0,0,12,0" Click="BtnImportar_Click"
                        IsEnabled="{Binding NoOcupado}"/>
                <Button x:Name="BtnBloquearRango" Content="Bloquear rango"
                        Style="{StaticResource BotonAccion}" Margin="0,0,12,0" Click="BtnBloquearRango_Click"
                        IsEnabled="{Binding NoOcupado}"/>
                <Button x:Name="BtnDesbloquearRango" Content="Desbloquear rango"
                        Style="{StaticResource BotonAccion}" Background="#6B7280" Click="BtnDesbloquearRango_Click"
                        IsEnabled="{Binding NoOcupado}"/>
            </WrapPanel>
        </Grid>

        <!-- ================= FORMULARIO DEL DÍA ================= -->
        <Border x:Name="PanelDia" Grid.Column="2" Background="White" CornerRadius="12" Margin="0,20,20,20" Padding="24"
                BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Día seleccionado -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <TextBlock Text="{Binding NombreDia}" FontSize="34" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="{Binding FechaTexto}" FontSize="15" Foreground="#6B7280"/>
                </StackPanel>

                <!-- Checkbox bloquear día: el cambio solo se aplica si la API lo acepta (ver Click) -->
                <CheckBox Grid.Row="1" Content="Bloquear día" FontSize="14" Margin="0,0,0,20"
                          VerticalContentAlignment="Center"
                          IsChecked="{Binding DiaActual.Bloqueado, Mode=OneWay}"
                          IsEnabled="{Binding NoOcupado}"
                          Click="ChkBloquearDia_Click"/>

                <!-- Tipo de día -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock Text="Tipo de día" Style="{StaticResource Etiqueta}"/>
                    <ComboBox Height="34" FontSize="14" VerticalContentAlignment="Center"
                              ItemsSource="{Binding TiposDia}"
                              SelectedItem="{Binding DiaActual.Tipo, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource MinusculasConverter}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Descripción -->
                <DockPanel Grid.Row="3" Margin="0,0,0,16">
                    <TextBlock DockPanel.Dock="Top" Text="Descripción" Style="{StaticResource Etiqueta}"/>
                    <TextBox FontSize="14" Padding="6" AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                             Text="{Binding DiaActual.Descripcion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DockPanel>

                <!-- Guardar -->
                <StackPanel Grid.Row="4">
                    <Button Content="Guardar" Style="{StaticResource BotonAccion}" Click="BtnGuardar_Click"
                            IsEnabled="{Binding NoOcupado}"/>
                    <TextBlock Text="{Binding Estado}" FontSize="12" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#059669"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EstadoEsError}" Value="True">
                                        <Setter Property="Foreground" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= PÁGINA DE PROFESORES ================= -->
        <views:ProfesoresView x:Name="VistaProfesores" Grid.Column="1" Grid.ColumnSpan="2"
                              Visibility="Collapsed" ModificarSolicitado="VistaProfesores_ModificarSolicitado"/>

        <!-- ================= PÁGINA DE EDICIÓN DE UN PROFESOR (solo DIRECTOR) ================= -->
        <views:EditarProfesorView x:Name="VistaEditarProfesor" Grid.Column="1" Grid.ColumnSpan="2"
                                  Visibility="Collapsed"
                                  Guardado="VistaEditarProfesor_Guardado" Cancelado="VistaEditarProfesor_Cancelado"/>

        <!-- ================= PÁGINA DE LOGIN ================= -->
        <views:LoginView x:Name="VistaLogin" Grid.Column="1" Grid.ColumnSpan="2"
                         Visibility="Collapsed" LoginCorrecto="VistaLogin_LoginCorrecto"/>
    </Grid>
</Window>
