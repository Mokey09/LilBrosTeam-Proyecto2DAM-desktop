<UserControl x:Class="CalendarioApp.Views.EditarProfesorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsVisibleChanged="EditarProfesorView_IsVisibleChanged">

    <!-- Página de edición de un profesor (solo DIRECTOR). El DataContext (MainViewModel) se hereda de la ventana. -->
    <UserControl.Resources>
        <Style x:Key="EtiquetaCampo" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="CampoTexto" TargetType="TextBox">
            <Setter Property="Height" Value="34"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="BotonFormulario" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="24,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="borde" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Margin="20" Background="White" CornerRadius="12" Padding="24"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="Modificar profesor" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock x:Name="TxtSubtitulo" FontSize="13" Foreground="#6B7280"/>
            </StackPanel>

            <!-- Formulario (dos columnas) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Columna izquierda: datos personales y de contacto -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nombre *" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtNombre" Style="{StaticResource CampoTexto}" Margin="0,0,0,14" MaxLength="100"/>

                        <TextBlock Text="Apellidos *" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtApellidos" Style="{StaticResource CampoTexto}" Margin="0,0,0,14" MaxLength="150"/>

                        <TextBlock Text="DNI *" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtDni" Style="{StaticResource CampoTexto}" Margin="0,0,0,14" MaxLength="20"/>

                        <TextBlock Text="Email *" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtEmail" Style="{StaticResource CampoTexto}" Margin="0,0,0,14" MaxLength="150"/>

                        <TextBlock Text="Teléfono" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtTelefono" Style="{StaticResource CampoTexto}" Margin="0,0,0,14" MaxLength="20"/>

                        <TextBlock Text="Dirección" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtDireccion" Style="{StaticResource CampoTexto}" Margin="0,0,0,14" MaxLength="200"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Localidad" Style="{StaticResource EtiquetaCampo}"/>
                                <TextBox x:Name="TxtLocalidad" Style="{StaticResource CampoTexto}" MaxLength="100"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Código postal" Style="{StaticResource EtiquetaCampo}"/>
                                <TextBox x:Name="TxtCodigoPostal" Style="{StaticResource CampoTexto}" MaxLength="5"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <!-- Columna derecha: datos profesionales y acceso -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Cuerpo" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtCuerpo" Style="{StaticResource CampoTexto}" Margin="0,0,0,14" MaxLength="150"/>

                        <TextBlock Text="Departamento" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtDepartamento" Style="{StaticResource CampoTexto}" Margin="0,0,0,14" MaxLength="100"/>

                        <TextBlock Text="Especialidad" Style="{StaticResource EtiquetaCampo}"/>
                        <TextBox x:Name="TxtEspecialidad" Style="{StaticResource CampoTexto}" Margin="0,0,0,14" MaxLength="100"/>

                        <TextBlock Text="Rol" Style="{StaticResource EtiquetaCampo}"/>
                        <ComboBox x:Name="CmbRol" Height="34" FontSize="14" VerticalContentAlignment="Center"
                                  Margin="0,0,0,14"/>
                        <TextBlock x:Name="TxtAvisoRol" FontSize="12" Foreground="#6B7280" TextWrapping="Wrap"
                                   Margin="0,-10,0,14" Visibility="Collapsed"
                                   Text="No puedes cambiar tu propio rol (podrías quedarte sin acceso a esta página)."/>

                        <TextBlock Text="Nueva contraseña" Style="{StaticResource EtiquetaCampo}"/>
                        <PasswordBox x:Name="TxtPassword" Height="34" FontSize="14" Padding="6,0"
                                     VerticalContentAlignment="Center" Margin="0,0,0,4"/>
                        <TextBlock Text="Déjala vacía para mantener la contraseña actual." FontSize="12"
                                   Foreground="#6B7280" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <!-- Botones y estado -->
            <DockPanel Grid.Row="2" Margin="0,16,0,0" LastChildFill="True">
                <Button x:Name="BtnGuardar" DockPanel.Dock="Right" Content="Guardar" Margin="12,0,0,0"
                        Style="{StaticResource BotonFormulario}" IsEnabled="{Binding NoOcupado}"
                        Click="BtnGuardar_Click"/>
                <Button x:Name="BtnCancelar" DockPanel.Dock="Right" Content="Cancelar"
                        Style="{StaticResource BotonFormulario}" Background="#6B7280"
                        IsEnabled="{Binding NoOcupado}" Click="BtnCancelar_Click"/>
                <TextBlock Text="{Binding Estado}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#059669"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding EstadoEsError}" Value="True">
                                    <Setter Property="Foreground" Value="#DC2626"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
