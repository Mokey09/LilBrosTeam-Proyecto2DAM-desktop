<UserControl x:Class="CalendarioApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FAF8F3"
             IsVisibleChanged="LoginView_IsVisibleChanged">

    <UserControl.Resources>
        <SolidColorBrush x:Key="Azul" Color="#0B2A5B"/>
        <SolidColorBrush x:Key="Verde" Color="#6A9A47"/>
        <SolidColorBrush x:Key="BordeCampo" Color="#E3E3E3"/>

        <Style x:Key="EtiquetaLogin" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource Azul}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Campo de texto con bordes redondeados -->
        <Style x:Key="CampoLogin" TargetType="TextBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="borde" Background="White" CornerRadius="10"
                                BorderBrush="{StaticResource BordeCampo}" BorderThickness="1.5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource Azul}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="borde" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CampoPassword" TargetType="PasswordBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="borde" Background="White" CornerRadius="10"
                                BorderBrush="{StaticResource BordeCampo}" BorderThickness="1.5">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="borde" Property="BorderBrush" Value="{StaticResource Azul}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="borde" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón azul marino con candado verde; el texto es el Content (cambia a "Entrando…") -->
        <Style x:Key="BotonEntrar" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource Azul}"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde" Background="{TemplateBinding Background}" CornerRadius="10">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                           Foreground="#7FB05A" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="borde" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Hoja decorativa (contorno verde) -->
        <Geometry x:Key="Hoja">M0,0 C6,-34 34,-62 70,-72 C70,-38 42,-8 0,0 Z</Geometry>
    </UserControl.Resources>

    <Grid ClipToBounds="True">

        <!-- ===== Triángulo azul de fondo (esquina inferior izquierda) ===== -->
        <Viewbox Stretch="Fill">
            <Canvas Width="100" Height="100">
                <Polygon Points="0,35 0,100 58,100" Fill="{StaticResource Azul}"/>
            </Canvas>
        </Viewbox>

        <!-- ===== Libros y lápices (dibujo tenue sobre el azul) ===== -->
        <Canvas Width="210" Height="190" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="24,0,0,24" Opacity="0.14" IsHitTestVisible="False">
            <Rectangle Canvas.Left="0" Canvas.Top="150" Width="190" Height="14" RadiusX="2" RadiusY="2"
                       Stroke="White" StrokeThickness="2"/>
            <Rectangle Canvas.Left="10" Canvas.Top="132" Width="170" Height="16" RadiusX="2" RadiusY="2"
                       Stroke="White" StrokeThickness="2"/>
            <Rectangle Canvas.Left="4" Canvas.Top="112" Width="176" Height="18" RadiusX="2" RadiusY="2"
                       Stroke="White" StrokeThickness="2"/>
            <Rectangle Canvas.Left="14" Canvas.Top="20" Width="52" Height="90" RadiusX="3" RadiusY="3"
                       Stroke="White" StrokeThickness="2"/>
            <Line X1="40" Y1="20" X2="40" Y2="110" Stroke="White" StrokeThickness="2"/>
            <Rectangle Canvas.Left="100" Canvas.Top="72" Width="40" Height="40" RadiusX="3" RadiusY="3"
                       Stroke="White" StrokeThickness="2"/>
            <Line X1="112" Y1="72" X2="124" Y2="20" Stroke="White" StrokeThickness="2"/>
            <Line X1="126" Y1="72" X2="148" Y2="26" Stroke="White" StrokeThickness="2"/>
        </Canvas>

        <!-- ===== Planta decorativa (esquina inferior derecha) ===== -->
        <Canvas Width="190" Height="260" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,10,0" IsHitTestVisible="False">
            <Path Data="M110,270 C104,200 112,130 138,40" Stroke="{StaticResource Verde}"
                  StrokeThickness="3" StrokeStartLineCap="Round"/>
            <Path Data="{StaticResource Hoja}" Stroke="{StaticResource Verde}" StrokeThickness="3"
                  StrokeLineJoin="Round" Canvas.Left="138" Canvas.Top="44">
                <Path.RenderTransform><RotateTransform Angle="-8"/></Path.RenderTransform>
            </Path>
            <Path Data="{StaticResource Hoja}" Stroke="{StaticResource Verde}" StrokeThickness="3"
                  StrokeLineJoin="Round" Canvas.Left="125" Canvas.Top="100">
                <Path.RenderTransform><RotateTransform Angle="-40"/></Path.RenderTransform>
            </Path>
            <Path Data="{StaticResource Hoja}" Stroke="{StaticResource Verde}" StrokeThickness="3"
                  StrokeLineJoin="Round" Canvas.Left="116" Canvas.Top="130">
                <Path.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <RotateTransform Angle="40"/>
                    </TransformGroup>
                </Path.RenderTransform>
            </Path>
            <Path Data="{StaticResource Hoja}" Stroke="{StaticResource Verde}" StrokeThickness="3"
                  StrokeLineJoin="Round" Canvas.Left="108" Canvas.Top="190">
                <Path.RenderTransform><RotateTransform Angle="-45"/></Path.RenderTransform>
            </Path>
        </Canvas>

        <!-- ===== Tarjeta de login (se reduce si la ventana es pequeña) ===== -->
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" Margin="20"
                 VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Width="440" Background="White" CornerRadius="16" Padding="40,28,40,36"
                    BorderBrush="#EFEFEF" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.12"/>
                </Border.Effect>
                <StackPanel>
                    <Image Source="/Assets/logoMZ.png" Height="100" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" Margin="0,0,0,14"/>

                    <TextBlock Text="Acceso al sistema" FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource Azul}" HorizontalAlignment="Center"
                               Margin="0,0,0,22"/>

                    <!-- Aviso informativo (p. ej. "tu sesión ha caducado") -->
                    <Border x:Name="PanelAviso" Visibility="Collapsed" Background="#FEF3C7" CornerRadius="8"
                            Padding="12,8" Margin="0,0,0,16">
                        <TextBlock x:Name="TxtAviso" TextWrapping="Wrap" FontSize="12" Foreground="#92400E"/>
                    </Border>

                    <TextBlock Text="Correo electrónico" Style="{StaticResource EtiquetaLogin}"/>
                    <TextBox x:Name="TxtEmail" Style="{StaticResource CampoLogin}"
                             Margin="0,0,0,16" KeyDown="Campo_KeyDown"/>

                    <TextBlock Text="Contraseña" Style="{StaticResource EtiquetaLogin}"/>
                    <PasswordBox x:Name="TxtPassword" Style="{StaticResource CampoPassword}"
                                 Margin="0,0,0,20" KeyDown="Campo_KeyDown"/>

                    <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"
                               Visibility="Collapsed" Margin="0,0,0,12"/>

                    <Button x:Name="BtnEntrar" Content="Iniciar sesión" Style="{StaticResource BotonEntrar}"
                            Click="BtnEntrar_Click"/>
                </StackPanel>
            </Border>
        </Viewbox>
    </Grid>
</UserControl>
