<UserControl x:Class="CalendarioApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F3F4F6"
             IsVisibleChanged="LoginView_IsVisibleChanged">

    <UserControl.Resources>
        <Style x:Key="EtiquetaLogin" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="BotonEntrar" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="borde" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="borde" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="borde" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Width="380" VerticalAlignment="Center" HorizontalAlignment="Center"
            Background="White" CornerRadius="12" Padding="32"
            BorderBrush="#E5E7EB" BorderThickness="1">
        <StackPanel>
            <TextBlock Text="Iniciar sesión" FontSize="28" FontWeight="Bold" Foreground="#111827"/>
            <TextBlock Text="Acceso para gestores y directores" FontSize="13" Foreground="#6B7280"
                       Margin="0,4,0,24"/>

            <!-- Aviso informativo (p. ej. "tu sesión ha caducado") -->
            <Border x:Name="PanelAviso" Visibility="Collapsed" Background="#FEF3C7" CornerRadius="8"
                    Padding="12,8" Margin="0,0,0,16">
                <TextBlock x:Name="TxtAviso" TextWrapping="Wrap" FontSize="12" Foreground="#92400E"/>
            </Border>

            <TextBlock Text="Correo electrónico" Style="{StaticResource EtiquetaLogin}"/>
            <TextBox x:Name="TxtEmail" Height="34" FontSize="14" VerticalContentAlignment="Center"
                     Margin="0,0,0,16" KeyDown="Campo_KeyDown"/>

            <TextBlock Text="Contraseña" Style="{StaticResource EtiquetaLogin}"/>
            <PasswordBox x:Name="TxtPassword" Height="34" FontSize="14" VerticalContentAlignment="Center"
                         Margin="0,0,0,16" KeyDown="Campo_KeyDown"/>

            <TextBlock x:Name="TxtError" Foreground="#DC2626" FontSize="12" TextWrapping="Wrap"
                       Visibility="Collapsed" Margin="0,0,0,12"/>

            <Button x:Name="BtnEntrar" Content="Entrar" Style="{StaticResource BotonEntrar}"
                    Click="BtnEntrar_Click"/>
        </StackPanel>
    </Border>
</UserControl>
